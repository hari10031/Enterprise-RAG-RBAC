# Copy to .env (keep this file). Uncomment exactly ONE LLM provider block: if a key appears twice,
# the FIRST one wins, so a second uncommented block is silently ignored.
# Model ids are examples: check the provider's model list.

DATABASE_URL=postgresql://eka:eka@localhost:5432/eka
DATA_DIR=./data
# Embedding and re-ranker weights (about 150 MB, downloaded on first use). Without this they go to %TEMP%.
MODELS_DIR=./models

# --- Google Gemini ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-flash-latest
# "none" turns off thinking: about 2 s to the first word instead of 10 s or more. Model-specific:
# gemini-flash-lite-latest rejects "none" (use "low" or leave unset).
LLM_REASONING_EFFORT=none

# --- Nebius AI Studio ---
# LLM_BASE_URL=https://api.studio.nebius.com/v1/
# LLM_API_KEY=
# LLM_MODEL=Qwen/Qwen3-32B

# --- NVIDIA NIM (hosted) ---
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=
# LLM_MODEL=qwen/qwen3-next-80b-a3b-instruct

# --- Local Ollama ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=none
# LLM_MODEL=qwen3:8b

# Hosted providers queue on their side; raise this for more concurrent answers.
LLM_PARALLEL=2
# Cross-encoder logit gate; calibrate on the eval set.
RERANK_THRESHOLD=-4.0
# Local development over plain http needs this false; keep true behind nginx TLS.
COOKIE_SECURE=false
OCR_ENABLED=false
